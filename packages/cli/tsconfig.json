{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    /* `allowSyntheticDefaultImports` es redundante con bundler/ESM */
    // "allowSyntheticDefaultImports": true,
    /* Opcionales de "seguridad" de tipos altamente recomendables */
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    /* Útiles si importas JSON o usas paths */
    "resolveJsonModule": true,
    "baseUrl": ".",
    // "paths": { "@/*": ["src/*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "scripts",
    "e2e"
  ]
  /* No "exclude": this was the only tsconfig in the repo excluding its test files, and 285
   * type errors accumulated invisibly behind it — including mocks of functions that do not
   * exist anywhere (findGitgovRoot) and imports from the wrong layer (Git.GitModule from the
   * root barrel). Typechecking is static: it needs no Postgres and no network, so "the e2e
   * suites only run locally" is a runner decision (vitest config / CI jobs), never a reason
   * to exclude files from tsc. */
}