{
  "name": "@gitgov/agent-review-advisor",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --external:@gitgov/core",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && jest"
  },
  "gitgov": {
    "agent": {
      "purpose": "review",
      "function": "runReviewAdvisor",
      "categories": [],
      "metadata": {
        "defaultModel": "anthropic/claude-sonnet-4-6"
      },
      "env": ["LLM_MODEL", "LLM_API_KEY"]
    }
  },
  "dependencies": {
    "@gitgov/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
