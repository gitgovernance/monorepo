{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "paths": {
      // No wildcard for subpaths: "@gitgov/core/*" -> "../../core/src/*" pointed at
      // directories that do not exist (@gitgov/core/fs lives in src/shared/fs/fs.ts,
      // /audit in src/audit/index.ts) and there is no single glob that maps them all.
      // Subpaths resolve through the workspace link against core's package.json
      // "exports" — same as packages/cli and saas-api, which declare no mapping at all.
      "@gitgov/core": ["../../core/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src", "*.test.ts"],
  "exclude": ["node_modules", "dist"]
}
